{
  "name": "tumugi",
  "version": "1.0.0",
  "description": "共感AIつむぎ — デスクトップアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build-win": "electron-builder --win"
  },
  "build": {
    "appId": "com.tumugi.app",
    "productName": "つむぎ",
    "copyright": "Copyright © 2026 Hiro-Sai",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "net-policy.js",
      "memory-crypto.js",
      "ollama-relay.js",
      "task-queue.js",
      "ipc-guard.js",
      "index.html",
      "login.html",
      "admin-dashboard.html",
      "js/**",
      "css/**",
      "images/**",
      "!**/.git/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "つむぎ",
      "installerLanguages": [
        "ja"
      ],
      "language": "1041"
    }
  },
  "dependencies": {
    "@fontsource/biz-udpgothic": "^5.3.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^24.0.0"
  }
}
