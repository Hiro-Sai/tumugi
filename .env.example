# =========================================
# .env.example
# このファイルをコピーして「.env」という名前で保存し、値を書き換えて使ってください。
# .env 本体は絶対にリポジトリに含めないこと（.gitignore で除外済み）。
# =========================================

# --- DB ---
DB_NAME=tumugi_demo
DB_USER=tumugi_app
DB_PASS=change_me
DB_ROOT_PASS=change_me_root

# --- デモデータ ---
# true: 起動時にデモ用の社員・感情ログを投入する / false: 何もしない（実運用では false）
DEMO_SEED=true
# デモアカウント（E001〜E048、A001）共通のログインパスワード。英数字だけで、推測されにくい長めの値を決めること。
# 例の値は入れていない（公開している例の値のまま使うと、だれでもデモの管理者 A001 でログインできてしまうため）。
# 空のままだと、デモデータを入れずに止まる（tumugi_server/tools/seed_demo.php）。
DEMO_PASSWORD=
